# Both application replicas use identical DB/owner/session/OAuth/Cognito values.
# REPLICA_ID is deliberately different on each instance. Never commit populated values.
DATABASE_DRIVER=postgres
DATABASE_URL=postgresql://replace-user:replace-password@replace-db-host:5432/replace-database
DATABASE_SSL_MODE=verify-full
# Optional verified private/RDS CA file path mounted in each container.
DATABASE_SSL_CA_FILE=
DATABASE_POOL_MAX=10
DATABASE_AUTO_MIGRATE=0
REPLICA_ID=ec2-a
# Optional separate DDL credential, used only by the migration command.
DATABASE_MIGRATION_URL=
TRACKER_OWNER_ID=replace-with-your-owner-id
# Four-digit PIN matches the existing UI; protected by a global attempt limit.
TRACKER_ACCESS_CODE=replace-with-four-digit-pin
TRACKER_SESSION_SECRET=replace-with-random-secret-at-least-32-characters
PUBLIC_BASE_URL=https://tracker.example.com
# Optional private bearer token for direct MCP clients and testing.
TRACKER_MCP_TOKEN=
# For ChatGPT OAuth: configure a client ID and EXACT callback URLs supplied by ChatGPT.
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URIS=

# Optional Cognito SSO. Leave ALL these empty until Cognito is configured.
# Keep pin until all Cognito settings and the owner subject are configured on both replicas.
TRACKER_AUTH_MODE=pin
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
COGNITO_DOMAIN=
# Exact Cognito sub that retains existing owner records; other verified users get separate accounts.
COGNITO_OWNER_SUB=
