# Copy to .env for Docker; never commit populated environment files.
TRACKER_OWNER_ID=replace-with-your-owner-id
# Four-digit PIN matches the existing UI; protected by a global attempt limit.
TRACKER_ACCESS_CODE=replace-with-four-digit-pin
TRACKER_SESSION_SECRET=replace-with-random-secret-at-least-32-characters
PUBLIC_BASE_URL=https://tracker.example.com
# Optional private bearer token for direct MCP clients and testing.
TRACKER_MCP_TOKEN=
# For ChatGPT OAuth: configure a client ID and EXACT callback URLs supplied by ChatGPT.
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URIS=

# Optional Cognito SSO. Leave ALL these empty until Cognito is configured.
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
COGNITO_DOMAIN=
# Exact Cognito sub of the sole tracker owner; never authorize every pool user.
COGNITO_OWNER_SUB=
